# Copy to .env and fill in. Used by both `npm run dev` (host) and
# scripts/sbuddy.sh / docker compose (long-running stack).
# Generate secrets with: openssl rand -hex 32

NODE_ENV=development
PORT=3000

# --- Postgres / Redis (docker compose) ---
POSTGRES_DB=sbuddy_db
POSTGRES_USER=sbuddy
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Host-side URLs for `npm run dev`; the API container builds its own from the values above
DATABASE_URL=postgresql://sbuddy:change-me@localhost:5432/sbuddy_db
REDIS_URL=redis://:change-me@localhost:6379
# Set true only for a managed Postgres that requires TLS
DATABASE_SSL=false

# --- Backups (scripts/sbuddy.sh backup / schedule-backups) ---
# Where dumps are kept (outside the Docker volume). Default: ~/sbuddy-backups
#BACKUP_DIR=~/sbuddy-backups
# Optional second copy, ideally synced off this machine (e.g. ~/Dropbox/sbuddy-backups)
#BACKUP_COPY_DIR=
# Daily scheduled backup time, HH:MM (re-run schedule-backups after changing)
#BACKUP_TIME=03:00

# --- Secrets (each at least 32 chars) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
# Set true only when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# --- External services ---
# The server refuses to start without these. Placeholders work for the
# test viewer; replace with real keys to use the corresponding features.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
OPENAI_API_KEY=placeholder
# Vision transcription for the MATHCOUNTS bulk import (scripts/mathcounts/).
# Only that script reads it; the server does not need it.
OPENROUTER_API_KEY=placeholder
OCR_SERVICE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=placeholder
SMTP_PASS=placeholder

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3000

# Cloudflare Tunnel token for the public viewer (docs/CLOUDFLARE_TUNNEL.md)
CLOUDFLARE_TUNNEL_TOKEN=
# LAN IPv4 to publish the API on (default 0.0.0.0 also exposes IPv6)
API_BIND_IP=
